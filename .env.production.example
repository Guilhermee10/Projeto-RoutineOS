# Modelo do ".env" que fica NO SERVIDOR (EC2). NUNCA commite o ".env" real.
# Senha do banco sem os caracteres @ : / ? # (ela entra na URL).
DATABASE_URL=postgresql://routineos_admin:SENHA@ENDPOINT-DO-RDS:5432/routineos?sslmode=require
# Gere com: openssl rand -hex 48
JWT_SECRET=
# Endereço HTTPS do frontend (CloudFront), sem barra no final
CORS_ORIGIN=
# Opcional: resumo semanal por IA
ANTHROPIC_API_KEY=
