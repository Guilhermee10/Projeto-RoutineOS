# Usado pelo docker-compose.yml (só para o banco local de desenvolvimento).
# Copie para ".env" na raiz e troque a senha. Em produção use um segredo real
# (gerenciador de segredos / variáveis do serviço), nunca um arquivo no Git.
POSTGRES_USER=routineos_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=routineos
