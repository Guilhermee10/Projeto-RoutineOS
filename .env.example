# Usado pelo docker-compose (banco local e, opcionalmente, o sistema inteiro
# em containers). Copie para ".env" na raiz e ajuste. NUNCA commite o ".env".
POSTGRES_USER=routineos_user
# Use uma senha SEM caracteres especiais de URL (@ : / ? #), pois ela entra na DATABASE_URL
POSTGRES_PASSWORD=changeme
POSTGRES_DB=routineos

# Só para docker-compose.app.yml (sistema inteiro em containers).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opcional: resumo semanal por IA
ANTHROPIC_API_KEY=
