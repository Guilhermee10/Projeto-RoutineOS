# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados (PostgreSQL) - formato exigido pelo Prisma
# postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://routineos_user:changeme@localhost:5432/routineos"

# Autenticação
# Gere um valor aleatório (>= 32 caracteres) com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NUNCA commite o arquivo .env - só este .env.example (sem segredos reais).
JWT_SECRET=changeme_use_um_valor_forte_aqui
# Endereço(s) do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGIN=http://localhost:5173
# Access token curto de propósito (quem dura é o refresh token) -
# formatos aceitos: Ns, Nm, Nh, Nd (ver src/utils/duration.js)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# IA - resumo semanal (opcional). Sem isso, o endpoint de resumo por
# IA responde com um erro claro em vez de quebrar o resto do app.
# Pegue sua key em https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# AWS (preenchido só quando formos fazer deploy - Sprint 12)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
